
-- 1) Creamos la base de datos (si no existe) y la seleccionamos
CREATE DATABASE rubrigrade;
USE rubrigrade;


-- TABLA 1: students  (Alumnado)

CREATE TABLE students (
    id              INT AUTO_INCREMENT PRIMARY KEY,
    first_name      VARCHAR(50)  NOT NULL,
    last_name       VARCHAR(50)  NOT NULL,
    email           VARCHAR(100) UNIQUE,
    enrollment_number VARCHAR(20) UNIQUE,           -- NIA / nº matrícula
    created_at      TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


-- TABLA 2: subjects  (Asignaturas / Módulos)

CREATE TABLE subjects (
    id              INT AUTO_INCREMENT PRIMARY KEY,
    code            VARCHAR(20)  NOT NULL UNIQUE,   -- Ej: "DAW-PROG"
    name            VARCHAR(100) NOT NULL,          -- Ej: "Programación"
    description     TEXT,
    academic_year   VARCHAR(10)                     -- Ej: "2025/26"
);


-- TABLA 3: rubrics  (Plantillas de rúbrica)

CREATE TABLE rubrics (
    id              INT AUTO_INCREMENT PRIMARY KEY,
    name            VARCHAR(100) NOT NULL,          -- Ej: "Rúbrica Proyecto Java"
    description     TEXT,
    max_score       DECIMAL(5,2) NOT NULL DEFAULT 10.00,
    created_at      TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


-- TABLA 4: rubric_criteria  (Criterios que componen cada rúbrica)

CREATE TABLE rubric_criteria (
    id              INT AUTO_INCREMENT PRIMARY KEY,
    rubric_id       INT          NOT NULL,
    name            VARCHAR(100) NOT NULL,          -- Ej: "Funcionalidad"
    description     TEXT,
    max_score       DECIMAL(5,2) NOT NULL,          -- Ej: 2.00
    display_order   INT DEFAULT 0,                  -- Para mostrarlos ordenados
    CONSTRAINT fk_criteria_rubric
        FOREIGN KEY (rubric_id) REFERENCES rubrics(id)
        ON DELETE CASCADE,                          -- Si borro rúbrica, sus criterios fuera
    CONSTRAINT uq_criterion_per_rubric
        UNIQUE (rubric_id, name)                    -- No dos criterios iguales en una misma rúbrica
);


-- TABLA 5: activities  (Actividades evaluables)

CREATE TABLE activities (
    id              INT AUTO_INCREMENT PRIMARY KEY,
    subject_id      INT          NOT NULL,
    rubric_id       INT          NOT NULL,
    name            VARCHAR(100) NOT NULL,
    description     TEXT,
    max_score       DECIMAL(5,2) NOT NULL DEFAULT 10.00,
    weight          DECIMAL(5,2) DEFAULT 100.00,    -- % sobre nota del trimestre
    due_date        DATE,
    CONSTRAINT fk_activity_subject
        FOREIGN KEY (subject_id) REFERENCES subjects(id),
    CONSTRAINT fk_activity_rubric
        FOREIGN KEY (rubric_id)  REFERENCES rubrics(id)
);


-- TABLA 6: student_activity_grades  (Nota global de alumno en actividad)

CREATE TABLE student_activity_grades (
    id              INT AUTO_INCREMENT PRIMARY KEY,
    student_id      INT          NOT NULL,
    activity_id     INT          NOT NULL,
    total_score     DECIMAL(5,2),                   -- Suma bruta de puntos
    final_grade     DECIMAL(5,2),                   -- Nota convertida a 0-10
    comments        TEXT,
    evaluated_at    TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_grade_student
        FOREIGN KEY (student_id)  REFERENCES students(id)
        ON DELETE CASCADE,
    CONSTRAINT fk_grade_activity
        FOREIGN KEY (activity_id) REFERENCES activities(id)
        ON DELETE CASCADE,
    CONSTRAINT uq_student_activity
        UNIQUE (student_id, activity_id)  -- Un alumno no puede tener 2 notas en la misma actividad
);


-- TABLA 7: student_criterion_scores  (Desglose por criterio)

CREATE TABLE student_criterion_scores (
    id                          INT AUTO_INCREMENT PRIMARY KEY,
    student_activity_grade_id   INT          NOT NULL,
    rubric_criterion_id         INT          NOT NULL,
    score                       DECIMAL(5,2) NOT NULL,
    comment                     TEXT,
    CONSTRAINT fk_score_grade
        FOREIGN KEY (student_activity_grade_id)
        REFERENCES student_activity_grades(id)
        ON DELETE CASCADE,
    CONSTRAINT fk_score_criterion
        FOREIGN KEY (rubric_criterion_id)
        REFERENCES rubric_criteria(id),
    CONSTRAINT uq_score_per_criterion
        UNIQUE (student_activity_grade_id, rubric_criterion_id),
    CONSTRAINT chk_score_positive
        CHECK (score >= 0)                          -- No puntuaciones negativas
);



